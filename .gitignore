venv/
__pycache__/
*.pyc
logs/
reports/
*.log
*.csv
# Keep sample CSVs that the web app serves to users
!apps/web/public/samples/*.csv

# Keep XSD files in schemas/ but ignore sample XMLs
*.xml
!schemas/*.xsd
# Characterization goldens are committed on purpose: they are the reference
# output the converter refactor is checked against. Without this exception the
# blanket *.xml rule silently excludes them and the tests regenerate-and-skip
# on every clean checkout, which passes while asserting nothing.
!tests/golden/*.xml

# Environment
.env

# Next.js
apps/web/.next/
apps/web/node_modules/
apps/web/.env.local
*.tsbuildinfo

# Data
/data/
uploads/
instance/

# Coverage / pytest
.coverage
coverage.xml
htmlcov/
.pytest_cache/
