datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  passwordHash     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  jobs             Job[]
  auditEntries     AuditEntry[]
  mappingTemplates MappingTemplate[]
}

model Job {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  converterType  String
  status         JobStatus @default(uploaded)
  inputFileName  String
  inputFilePath  String
  outputFilePath String?
  totalRows      Int?
  processedRows  Int       @default(0)
  columnMapping  Json?
  summary        Json?
  issues         Json?
  cleaningDiffs  Json?
  xsdValid       Boolean?
  xsdErrors      Json?
  previousJobId  String?
  previousJob    Job?      @relation("JobComparison", fields: [previousJobId], references: [id])
  nextJobs       Job[]     @relation("JobComparison")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  // Set when the retention sweep removed this job's files from disk.
  // The row (and its audit trail) survives; downloads show "expired".
  filesPurgedAt  DateTime?
  auditEntries   AuditEntry[]

  @@index([userId, createdAt(sort: Desc)])
}

// A named, reusable column mapping saved by a user for one converter
// type, so recurring Salesforce exports don't have to be re-mapped on
// every upload. The `mapping` JSON has the same {csvColumn: xmlField}
// shape as Job.columnMapping; the worker re-validates entries against
// the expected columns at convert time, so a stale template entry is
// dropped rather than misapplied.
model MappingTemplate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  converterType String
  name          String
  mapping       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, converterType, name])
  @@index([userId, converterType])
}

model AuditEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id])
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
}

enum JobStatus {
  uploaded
  previewed
  mapping
  queued
  converting
  complete
  error
  cancelled
}
